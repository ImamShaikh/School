# =============================================================================
#  .env.example  —  Copy this to .env and fill in your values for LOCAL DEV
#  NEVER commit .env to Git. Add .env to your .gitignore.
# =============================================================================

# Django
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- DATABASE ---
# On Render, DATABASE_URL is set automatically by the PostgreSQL add-on.
# For local MySQL dev, leave DATABASE_URL blank and fill the DB_* vars below.

# Render / Production (PostgreSQL — set this on Render dashboard):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
# Local MySQL fallback (used when DATABASE_URL is not set):

